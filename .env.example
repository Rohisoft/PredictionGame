# Copy this file to .env and fill in your Supabase project's values.
# Find these in your Supabase project settings under Project Settings > API.
# Only the anon (public) key belongs here — NEVER put the service_role key
# in a frontend .env file or commit it to git.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
