# MongoDB connection string. Must point at a replica set — a plain
# standalone mongod does NOT support the multi-document transactions
# placeBet/settleRound/adminAddPoints use. Two options:
#
# 1. Local dev via Docker (see docker-compose.yml in this folder — it runs
#    a single-node replica set for you):
#      docker compose up -d
#    then:
MONGODB_URI=mongodb://localhost:27017/prediction_game?replicaSet=rs0
#
# 2. MongoDB Atlas (production) — clusters are replica sets by default,
#    even on the free tier:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prediction_game?retryWrites=true&w=majority

# Long, random secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of allowed frontend origins (for CORS + cookies)
CORS_ORIGIN=http://localhost:5173

PORT=4000
NODE_ENV=development

# Optional SMTP config for password-reset emails. Without these, reset
# tokens are just logged to the server console (dev-only fallback) instead
# of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
